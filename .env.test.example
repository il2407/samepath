# Copy this file to .env.test — used only by the test suite (`pnpm test`).
#
# IMPORTANT: this must point at a *separate* `prisma dev` instance (a
# different --name/--db-port), not just a different database name on the
# same instance as your .env. `prisma dev`'s local engine does not isolate
# same-instance databases from each other (samepath_dev and samepath_test on
# the SAME instance share the underlying data) — only separate instances are
# genuinely isolated. See README.md "Local development setup".
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/samepath_test?sslmode=disable"
APP_URL="http://localhost:3000"
NODE_ENV="test"
SESSION_SECRET="test-session-secret-0000000000000000000000000000"
MAIL_ADAPTER="console"
MAIL_FROM="SamePath <no-reply@samepath.local>"
STORAGE_ADAPTER="local"
PAYMENT_PROVIDER="fake"
RESUME_PARSER="deterministic"
RATE_LIMIT_ADAPTER="memory"
GOOGLE_OAUTH_ADAPTER="fake"
