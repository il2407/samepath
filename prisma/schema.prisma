  id                    String              @id @default(cuid())
  experienceId          String
  experience            InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  stage                 InterviewStage
  format                InterviewFormat
  approxDurationMinutes Int?
  order                 Int                 @default(0)

