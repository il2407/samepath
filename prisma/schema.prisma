// SamePath data model.
// Organized to mirror the domain modules in src/modules/*.
// Naming: PascalCase models, camelCase fields, SCREAMING_SNAKE enum values.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// =============================================================================
// Reference / lookup data (extensible without schema changes: add rows, not columns)
// =============================================================================

model ProfessionalField {
  id        String   @id @default(cuid())
  code      String   @unique
  labelHe   String
  labelEn   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  targetRoles          TargetRole[]
  profiles             ProfessionalProfile[]
  groups               Group[]
  interviewExperiences InterviewExperience[]

  @@map("professional_fields")
}

model TargetRole {
  id                  String            @id @default(cuid())
  code                String            @unique
  professionalFieldId String
  professionalField   ProfessionalField @relation(fields: [professionalFieldId], references: [id])
  labelHe             String
  labelEn             String
  isActive            Boolean           @default(true)
  sortOrder           Int               @default(0)
  createdAt           DateTime          @default(now())

  profileTargetRoles   ProfileTargetRole[]
  groups               Group[]
  interviewExperiences InterviewExperience[]

  @@index([professionalFieldId])
  @@map("target_roles")
}

model SeniorityBand {
  id        String  @id @default(cuid())
  code      String  @unique
  labelHe   String
  labelEn   String
  minMonths Int
  maxMonths Int?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  profiles             ProfessionalProfile[]
  groupsMin            Group[]               @relation("GroupMinSeniority")
  groupsMax            Group[]               @relation("GroupMaxSeniority")
  interviewExperiences InterviewExperience[]

  @@map("seniority_bands")
}

model Language {
  id      String @id @default(cuid())
  code    String @unique
  labelHe String
  labelEn String

  profileLanguages ProfileLanguage[]
  connectionPrefs  ConnectionPreference[]
  groups           Group[]

  @@map("languages")
}

model Region {
  id      String @id @default(cuid())
  code    String @unique
  labelHe String
  labelEn String
  kind    String // COUNTRY | BROAD_AREA

  profiles             ProfessionalProfile[]
  interviewExperiences InterviewExperience[]

  @@map("regions")
}

enum TagKind {
  SKILL
  DOMAIN
  TOPIC
}

/// Unified lookup for skills, domains and interview-question topics.
/// A single "kind"-discriminated table keeps the compatibility engine's
/// combined "skills/domains overlap" bucket a simple set intersection.
model Tag {
  id        String   @id @default(cuid())
  kind      TagKind
  slug      String
  labelHe   String
  labelEn   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  profileTags    ProfileTag[]
  experienceTags InterviewExperienceTopic[]
  questionTags   InterviewQuestionTopic[]

  @@unique([kind, slug])
  @@map("tags")
}

// =============================================================================
// Identity, auth & sessions
// =============================================================================

enum UserStatus {
  ACTIVE
  PAUSED
  SUSPENDED
  DELETED
}

enum UserRole {
  MEMBER
  MODERATOR
  ADMIN
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?
  status          UserStatus @default(ACTIVE)
  role            UserRole   @default(MEMBER)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastLoginAt     DateTime?
  deletedAt       DateTime?

  authIdentities         AuthIdentity[]
  sessions               Session[]
  emailVerifications     EmailVerification[]
  professionalProfile    ProfessionalProfile?
  resumeUploads          ResumeUpload[]
  resumeExtractionDrafts ResumeExtractionDraft[]
  userConfirmations      UserConfirmation[]

  blockedCompanies         BlockedCompany[]
  blockingAsBlocker        BlockedUser[]          @relation("BlockedUserBlocker")
  blockingAsBlocked        BlockedUser[]          @relation("BlockedUserBlocked")
  privacyAuditsAsSubject   PrivacyDecisionAudit[] @relation("PrivacyAuditSubject")
  privacyAuditsAsCandidate PrivacyDecisionAudit[] @relation("PrivacyAuditCandidate")

  matchSuggestionsAsA   MatchSuggestion[]                @relation("MatchSuggestionUserA")
  matchSuggestionsAsB   MatchSuggestion[]                @relation("MatchSuggestionUserB")
  matchDecisions        MatchDecision[]
  connectionsAsA        Connection[]                     @relation("ConnectionUserA")
  connectionsAsB        Connection[]                     @relation("ConnectionUserB")
  sentMessages          ConnectionMessage[]
  meetingStatusesMarked MeetingStatus[]
  sessionTypeSelections ConnectionSessionTypeSelection[]

  reportsFiled    Report[] @relation("ReportReporter")
  reportsAgainst  Report[] @relation("ReportReportedUser")
  reportsResolved Report[] @relation("ReportResolver")

  groupMemberships GroupMembership[]
  groupWaitlist    GroupWaitlistEntry[]
  groupsCreated    Group[]              @relation("GroupCreatedBy")
  guidesCreated    SessionGuide[]       @relation("GuideCreatedBy")

  interviewExperiences     InterviewExperience[]         @relation("ExperienceAuthor")
  contributionReviews      ContributionReview[]
  revisionRequests         ContributionRevisionRequest[]
  contributionAttestations ContributionAttestation[]
  contributionValidations  ContributionValidation[]
  contentReports           ContentReport[]
  moderationActions        ModerationAction[]
  takedownsResolved        TakedownRequest[]

  creditLedgerEntries CreditLedgerEntry[]
  creditConversions   CreditConversion[]
  payments            Payment[]
  accessPasses        AccessPass[]
  notificationLogs    NotificationLog[]

  @@map("users")
}

enum AuthProviderType {
  EMAIL
  GOOGLE
}

/// One row per login method a user has configured: EMAIL carries a
/// scrypt passwordHash (providerAccountId = the user's email), GOOGLE
/// carries no passwordHash (providerAccountId = the Google account's
/// stable "sub" claim).
model AuthIdentity {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProviderType
  providerAccountId String
  passwordHash      String?
  createdAt         DateTime         @default(now())

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("auth_identities")
}

model Session {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  lastUsedAt DateTime  @default(now())
  userAgent  String?
  ipHash     String?
  revokedAt  DateTime?

  @@index([userId])
  @@map("sessions")
}

enum VerificationPurpose {
  REGISTER // confirm-your-email link sent right after password registration
  LOGIN // unused since passwordless login was removed; kept to avoid a Postgres enum-value-removal migration
  EMAIL_CHANGE
  PASSWORD_RESET
}

/// Link-only, single-use tokens (no code — nothing in the UI types a code
/// in anymore). Covers post-signup email confirmation and password reset.
model EmailVerification {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose    VerificationPurpose
  tokenHash  String              @unique
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int                 @default(0)
  requestIp  String?
  createdAt  DateTime            @default(now())

  @@index([userId, purpose])
  @@map("email_verifications")
}

// =============================================================================
// Professional profile
// =============================================================================

enum ProfileStatus {
  DRAFT
  PENDING_PRIVACY
  INCOMPLETE
  ACTIVE
  PAUSED
}

enum AvailabilityStatus {
  AVAILABLE
  PAUSED
}

/// The profile owner's own gender, self-reported — used only to evaluate
/// GenderPreference compatibility (see ConnectionPreference.genderPreference).
/// Nullable: existing profiles predate this field, and disclosing it is
/// optional. A null gender simply cannot satisfy the other side of a match
/// wanting MALE- or FEMALE-only (see gendersCompatible in the privacy engine).
enum Gender {
  MALE
  FEMALE
}

/// Who the profile owner is willing to be matched with, by gender.
/// BOTH (the default) applies no filter at all.
enum GenderPreference {
  MALE
  FEMALE
  BOTH
}

enum ResumeRetentionPreference {
  DELETE_AFTER_CONFIRMATION
  KEEP
}

model ProfessionalProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  professionalFieldId String?
  professionalField   ProfessionalField? @relation(fields: [professionalFieldId], references: [id])
  currentRoleTitle    String?

  seniorityBandId  String?
  seniorityBand    SeniorityBand? @relation(fields: [seniorityBandId], references: [id])
  experienceMonths Int            @default(0)

  regionId String?
  region   Region? @relation(fields: [regionId], references: [id])

  shortIntro String? @db.VarChar(400)
  gender     Gender?

  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  status             ProfileStatus      @default(DRAFT)

  currentCompanyId          String?
  currentCompany            Company?  @relation(fields: [currentCompanyId], references: [id])
  currentCompanyConfirmedAt DateTime?

  resumeRetentionPreference ResumeRetentionPreference @default(DELETE_AFTER_CONFIRMATION)

  /// Set the moment the profile owner confirms a resume-extraction draft
  /// (see ResumeExtractionDraft.confirmedAt / UserConfirmation.RESUME_DRAFT_CONFIRMED)
  /// — never set for a profile filled in manually. Surfaced pre-match (see
  /// PreMatchCandidateDTO.cvVerified) as a trust signal: it attests the
  /// profile's info was cross-checked against an uploaded CV at least once,
  /// not that the file itself is still stored (it may have been deleted
  /// right after, per resumeRetentionPreference).
  cvVerifiedAt DateTime?

  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targetRoles          ProfileTargetRole[]
  tags                 ProfileTag[]
  languages            ProfileLanguage[]
  employmentPositions  EmploymentPosition[]
  availabilitySlots    AvailabilitySlot[]
  connectionPreference ConnectionPreference?
  disclosurePreference IdentityDisclosurePreference?
  privacyPreference    PrivacyPreference?

  matchSuggestionsAsA MatchSuggestion[] @relation("ProfileA")
  matchSuggestionsAsB MatchSuggestion[] @relation("ProfileB")

  @@index([professionalFieldId, status])
  @@index([currentCompanyId])
  @@map("professional_profiles")
}

model ProfileTargetRole {
  id           String              @id @default(cuid())
  profileId    String
  profile      ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  targetRoleId String
  targetRole   TargetRole          @relation(fields: [targetRoleId], references: [id])

  @@unique([profileId, targetRoleId])
  @@map("profile_target_roles")
}

model ProfileTag {
  id        String              @id @default(cuid())
  profileId String
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag                 @relation(fields: [tagId], references: [id])

  @@unique([profileId, tagId])
  @@map("profile_tags")
}

model ProfileLanguage {
  id         String              @id @default(cuid())
  profileId  String
  profile    ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  languageId String
  language   Language            @relation(fields: [languageId], references: [id])

  @@unique([profileId, languageId])
  @@map("profile_languages")
}

enum EmploymentSource {
  RESUME
  MANUAL
}

model EmploymentPosition {
  id        String              @id @default(cuid())
  profileId String
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  companyRaw String

  title     String
  startDate DateTime
  endDate   DateTime?
  isCurrent Boolean          @default(false)
  source    EmploymentSource @default(MANUAL)
  createdAt DateTime         @default(now())

  @@index([profileId])
  @@index([companyId])
  @@map("employment_positions")
}

model AvailabilitySlot {
  id          String              @id @default(cuid())
  profileId   String
  profile     ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek   Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // minutes from midnight, local to ConnectionPreference.timezone
  endMinute   Int

  @@index([profileId])
  @@map("availability_slots")
}

enum ConnectionFormatPreference {
  ONE_ON_ONE
  GROUP
  BOTH
}

enum ConnectionCadence {
  ONE_TIME
  RECURRING
  BOTH
}

enum ConnectionModePreference {
  ONLINE
  IN_PERSON
  BOTH
}

enum ConnectionReason {
  SHARE_JOB_SEARCH
  ACCOUNTABILITY
  PROFESSIONAL_DISCUSSION
  LEARNING_TOGETHER
  INTRO_VIDEO_CALL
  CODING_PRACTICE
  SYSTEM_DESIGN
  INTERVIEW_SIMULATION
  PROJECT_PITCH
  BEHAVIORAL_INTERVIEW
  MENTAL_SUPPORT
  OTHER
}

model ConnectionPreference {
  id        String              @id @default(cuid())
  profileId String              @unique
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  peerMinExperienceMonths Int @default(0)
  peerMaxExperienceMonths Int @default(240)

  format           ConnectionFormatPreference @default(BOTH)
  cadence          ConnectionCadence          @default(BOTH)
  mode             ConnectionModePreference   @default(BOTH)
  genderPreference GenderPreference           @default(BOTH)

  languageId String?
  language   Language? @relation(fields: [languageId], references: [id])
  timezone   String    @default("Asia/Jerusalem")

  reasons ConnectionReason[]

  updatedAt DateTime @updatedAt

  @@map("connection_preferences")
}

/// Controls progressive identity disclosure: pre-match fields are never sent
/// to the client at all (see DTO layer), post-match fields are only included
/// once the corresponding boolean is true AND the connection is mutual.
///
/// There is deliberately no user-chosen pre-match name here: every candidate
/// card shows a system-generated funny nickname (see
/// src/modules/profiles/nickname.ts) plus a DiceBear avatar derived from that
/// same nickname (see src/shared/ui/Avatar.tsx), the same idea as an
/// anonymous collaborator in a shared Google Sheet — never something the
/// profile owner can pick or type, so it can never accidentally leak identity.
model IdentityDisclosurePreference {
  id        String              @id @default(cuid())
  profileId String              @unique
  profile   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  /// Real full name, private, collected once here so shareFullNamePostMatch
  /// has something to reveal — never read by any pre-match code path.
  fullName             String?
  /// Opt-in, defaults false: reveals the profile's current employer on the
  /// pre-match candidate card itself, not just post-match. Every suggestion
  /// that reaches that card has already passed the privacy hard filter
  /// (never same company, never a company either side has blocked), so this
  /// only ever surfaces an employer neither side has ruled out — but it is
  /// still a real anonymity trade-off the profile owner must choose, never
  /// something inferred or forced on them.
  shareCompanyPreMatch Boolean               @default(false)

  shareFullNamePostMatch        Boolean @default(false)
  /// Storage key of the uploaded profile photo (see src/shared/storage.ts),
  /// null until the user uploads one. Only ever read by post-match code
  /// paths, and even then only when sharePhotoPostMatch is true.
  photoStorageKey               String?
  photoMimeType                 String?
  sharePhotoPostMatch           Boolean @default(false)
  shareLinkedInPostMatch        Boolean @default(false)
  linkedInUrl                   String?
  sharePreciseLocationPostMatch Boolean @default(false)
  shareEmailPostMatch           Boolean @default(false)
  sharePhonePostMatch           Boolean @default(false)
  phoneNumber                   String?

  updatedAt DateTime @updatedAt

  @@map("identity_disclosure_preferences")
}

// =============================================================================
// Company & privacy
// =============================================================================

enum CompanyNormalizationStatus {
  CONFIRMED
  NEEDS_REVIEW
  MERGED
}

model CorporateGroup {
  id        String    @id @default(cuid())
  name      String
  createdAt DateTime  @default(now())
  companies Company[]

  @@map("corporate_groups")
}

model Company {
  id                  String                     @id @default(cuid())
  canonicalName       String
  domain              String?                    @unique
  corporateGroupId    String?
  corporateGroup      CorporateGroup?            @relation(fields: [corporateGroupId], references: [id])
  normalizationStatus CompanyNormalizationStatus @default(CONFIRMED)
  mergedIntoId        String?
  mergedInto          Company?                   @relation("CompanyMerge", fields: [mergedIntoId], references: [id])
  mergedFrom          Company[]                  @relation("CompanyMerge")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  aliases              CompanyAlias[]
  profilesCurrentAt    ProfessionalProfile[]
  employmentPositions  EmploymentPosition[]
  blockedByUsers       BlockedCompany[]
  interviewExperiences InterviewExperience[]
  takedownRequests     TakedownRequest[]

  @@index([corporateGroupId])
  @@map("companies")
}

model CompanyAlias {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  alias     String
  createdAt DateTime @default(now())

  @@unique([companyId, alias])
  @@index([alias])
  @@map("company_aliases")
}

enum BlockedCompanyReason {
  FORMER_EMPLOYER
  INTERVIEWING
  CLIENT_OR_VENDOR
  OTHER
}

model BlockedCompany {
  id        String               @id @default(cuid())
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company              @relation(fields: [companyId], references: [id])
  reason    BlockedCompanyReason
  note      String?
  createdAt DateTime             @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("blocked_companies")
}

model BlockedUser {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation("BlockedUserBlocker", fields: [userId], references: [id], onDelete: Cascade)
  blockedUserId String
  blockedUser   User     @relation("BlockedUserBlocked", fields: [blockedUserId], references: [id], onDelete: Cascade)
  reason        String?
  createdAt     DateTime @default(now())

  @@unique([userId, blockedUserId])
  @@index([blockedUserId])
  @@map("blocked_users")
}

/// Confirmed employer + corporate-group-blocking default. Kept separate from
/// IdentityDisclosurePreference because it governs eligibility (hard filters),
/// not what gets shown to a match.
model PrivacyPreference {
  id                        String              @id @default(cuid())
  profileId                 String              @unique
  profile                   ProfessionalProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  blockEntireCorporateGroup Boolean             @default(true)
  onboardingCompletedAt     DateTime?
  updatedAt                 DateTime            @updatedAt

  @@map("privacy_preferences")
}

enum PrivacyAuditContext {
  MATCH
  GROUP
  SESSION
  CONNECTION
}

enum PrivacyAuditDecision {
  ALLOW
  REJECT
}

/// Internal-only audit trail of every privacy-gate evaluation. Reason codes
/// here are for admin diagnostics ONLY and must never be surfaced to users
/// (see privacy engine requirement: never reveal why something was hidden).
model PrivacyDecisionAudit {
  id              String               @id @default(cuid())
  subjectUserId   String
  subjectUser     User                 @relation("PrivacyAuditSubject", fields: [subjectUserId], references: [id], onDelete: Cascade)
  candidateUserId String?
  candidateUser   User?                @relation("PrivacyAuditCandidate", fields: [candidateUserId], references: [id])
  context         PrivacyAuditContext
  contextId       String?
  decision        PrivacyAuditDecision
  reasonCode      String
  createdAt       DateTime             @default(now())

  @@index([subjectUserId, createdAt])
  @@map("privacy_decision_audits")
}

// =============================================================================
// Resume upload & extraction
// =============================================================================

enum ResumeUploadStatus {
  UPLOADED
  SCANNING
  READY
  REJECTED
  DELETED
}

model ResumeUpload {
  id               String             @id @default(cuid())
  userId           String
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey       String
  originalFilename String
  mimeType         String
  sizeBytes        Int
  status           ResumeUploadStatus @default(UPLOADED)
  uploadedAt       DateTime           @default(now())
  deletedAt        DateTime?

  extractionJob ResumeExtractionJob?

  @@index([userId])
  @@map("resume_uploads")
}

enum ResumeJobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

model ResumeExtractionJob {
  id             String          @id @default(cuid())
  resumeUploadId String          @unique
  resumeUpload   ResumeUpload    @relation(fields: [resumeUploadId], references: [id], onDelete: Cascade)
  status         ResumeJobStatus @default(QUEUED)
  attempt        Int             @default(0)
  error          String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime        @default(now())

  draft ResumeExtractionDraft?

  @@map("resume_extraction_jobs")
}

enum ParserSource {
  DETERMINISTIC
  AI
}

model ResumeExtractionDraft {
  id                    String              @id @default(cuid())
  resumeExtractionJobId String              @unique
  resumeExtractionJob   ResumeExtractionJob @relation(fields: [resumeExtractionJobId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  extractedJson         Json
  parserVersion         String
  parserSource          ParserSource
  confirmedAt           DateTime?
  createdAt             DateTime            @default(now())

  @@index([userId])
  @@map("resume_extraction_drafts")
}

enum ConfirmationType {
  EMPLOYER_CONFIRMED
  RESUME_DRAFT_CONFIRMED
  PRIVACY_ONBOARDING_CONFIRMED
}

model UserConfirmation {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      ConfirmationType
  payload   Json?
  createdAt DateTime         @default(now())

  @@index([userId, type])
  @@map("user_confirmations")
}

// =============================================================================
// Matching & connections
// =============================================================================

enum MatchStatus {
  PROPOSED
  INTERESTED_BY_A
  INTERESTED_BY_B
  MUTUALLY_ACCEPTED
  PAYMENT_PENDING
  ACCESS_CHECK
  ACTIVE
  DECLINED
  EXPIRED
  BLOCKED
  REPORTED
  CANCELLED
}

model MatchSuggestion {
  id      String @id @default(cuid())
  userAId String
  userA   User   @relation("MatchSuggestionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId String
  userB   User   @relation("MatchSuggestionUserB", fields: [userBId], references: [id], onDelete: Cascade)

  profileAId String
  profileA   ProfessionalProfile @relation("ProfileA", fields: [profileAId], references: [id])
  profileBId String
  profileB   ProfessionalProfile @relation("ProfileB", fields: [profileBId], references: [id])

  status    MatchStatus @default(PROPOSED)
  version   Int         @default(0)
  createdAt DateTime    @default(now())
  expiresAt DateTime
  decidedAt DateTime?

  scoreBreakdown MatchScoreBreakdown?
  decisions      MatchDecision[]
  connection     Connection?
  reports        Report[]

  @@index([userAId, status])
  @@index([userBId, status])
  @@map("match_suggestions")
}

/// Per-criterion score breakdown, used for admin diagnostics and tests. Only
/// two derived values ever reach an end user: the rounded totalScore (shown
/// as a match percentage) and the safe, category-level reasons derived from
/// it (see generateSafeReasons) — never the individual sub-scores here.
model MatchScoreBreakdown {
  id                String          @id @default(cuid())
  matchSuggestionId String          @unique
  matchSuggestion   MatchSuggestion @relation(fields: [matchSuggestionId], references: [id], onDelete: Cascade)

  targetRoleScore   Float
  fieldScore        Float
  experienceScore   Float
  availabilityScore Float
  skillsScore       Float
  languageScore     Float
  totalScore        Float
  weightsVersion    String
  computedAt        DateTime @default(now())

  @@map("match_score_breakdowns")
}

enum MatchDecisionType {
  INTERESTED
  NOT_NOW
  NOT_RELEVANT
  NEVER_AGAIN
  REPORT
}

model MatchDecision {
  id                String            @id @default(cuid())
  matchSuggestionId String
  matchSuggestion   MatchSuggestion   @relation(fields: [matchSuggestionId], references: [id], onDelete: Cascade)
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  decision          MatchDecisionType
  createdAt         DateTime          @default(now())

  @@unique([matchSuggestionId, userId])
  @@map("match_decisions")
}

enum ConnectionStatus {
  ACTIVE
  ENDED
  BLOCKED
  REPORTED
}

model Connection {
  id                String           @id @default(cuid())
  matchSuggestionId String           @unique
  matchSuggestion   MatchSuggestion  @relation(fields: [matchSuggestionId], references: [id])
  userAId           String
  userA             User             @relation("ConnectionUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId           String
  userB             User             @relation("ConnectionUserB", fields: [userBId], references: [id], onDelete: Cascade)
  status            ConnectionStatus @default(ACTIVE)
  createdAt         DateTime         @default(now())
  endedAt           DateTime?

  /// The suggested session structure the pair picked for their first meeting
  /// (spec: a suggested, never-mandatory walkthrough so both sides know
  /// what to expect going in). Nullable — most connections never pick one.
  selectedGuideId String?
  selectedGuide   SessionGuide? @relation(fields: [selectedGuideId], references: [id])

  messages              ConnectionMessage[]
  meetingStatuses       MeetingStatus[]
  reports               Report[]
  sessionTypeSelections ConnectionSessionTypeSelection[]

  @@index([userAId, status])
  @@index([userBId, status])
  @@map("connections")
}

/// Each participant's independent, non-binding record of what they'd like this
/// connection's session(s) to actually be (technical mock interview, project
/// pitch, etc.) — visible to the other side but never requires agreement, same
/// advisory model as Connection.selectedGuideId.
model ConnectionSessionTypeSelection {
  id           String             @id @default(cuid())
  connectionId String
  connection   Connection         @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  userId       String
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionTypes ConnectionReason[]
  updatedAt    DateTime           @updatedAt

  @@unique([connectionId, userId])
  @@map("connection_session_type_selections")
}

model ConnectionMessage {
  id           String     @id @default(cuid())
  connectionId String
  connection   Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User       @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body         String     @db.VarChar(4000)
  createdAt    DateTime   @default(now())

  @@index([connectionId, createdAt])
  @@map("connection_messages")
}

model MeetingStatus {
  id             String     @id @default(cuid())
  connectionId   String
  connection     Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  scheduledAt    DateTime?
  completedAt    DateTime?
  markedByUserId String?
  markedBy       User?      @relation(fields: [markedByUserId], references: [id])
  note           String?
  createdAt      DateTime   @default(now())

  @@index([connectionId])
  @@map("meeting_statuses")
}

enum ReportCategory {
  SAFETY_CONCERN
  HARASSMENT
  SPAM
  FAKE_PROFILE
  PRIVACY_CONCERN
  NO_SHOW
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model Report {
  id                String           @id @default(cuid())
  reporterId        String
  reporter          User             @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUserId    String?
  reportedUser      User?            @relation("ReportReportedUser", fields: [reportedUserId], references: [id])
  connectionId      String?
  connection        Connection?      @relation(fields: [connectionId], references: [id])
  matchSuggestionId String?
  matchSuggestion   MatchSuggestion? @relation(fields: [matchSuggestionId], references: [id])
  groupId           String?
  group             Group?           @relation(fields: [groupId], references: [id])
  category          ReportCategory
  description       String           @db.VarChar(2000)
  status            ReportStatus     @default(OPEN)
  createdAt         DateTime         @default(now())
  resolvedAt        DateTime?
  resolvedByUserId  String?
  resolvedBy        User?            @relation("ReportResolver", fields: [resolvedByUserId], references: [id])
