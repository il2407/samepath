enum GuideFormat {
  ONE_ON_ONE
  GROUP
  BOTH
}

enum GuideStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model SessionGuide {
  id                       String      @id @default(cuid())
  title                    String
  purpose                  String      @db.VarChar(1000)
  suggestedDurationMinutes Int
  format                   GuideFormat @default(BOTH)
  category                 String?
  status                   GuideStatus @default(DRAFT)
  order                    Int         @default(0)
  createdByUserId          String?
  createdBy                User?       @relation("GuideCreatedBy", fields: [createdByUserId], references: [id])
