enum GroupMode {
  ONLINE
  IN_PERSON
}

enum GroupStatus {
  DRAFT
  OPEN
  FULL
  CLOSED
  ARCHIVED
}

model Group {
  id                  String             @id @default(cuid())
  title               String
  professionalFieldId String?
  professionalField   ProfessionalField? @relation(fields: [professionalFieldId], references: [id])
  targetRoleId        String?
  targetRole          TargetRole?        @relation(fields: [targetRoleId], references: [id])
  minSeniorityBandId  String?
  minSeniorityBand    SeniorityBand?     @relation("GroupMinSeniority", fields: [minSeniorityBandId], references: [id])
  maxSeniorityBandId  String?
  maxSeniorityBand    SeniorityBand?     @relation("GroupMaxSeniority", fields: [maxSeniorityBandId], references: [id])
  languageId          String?
  language            Language?          @relation(fields: [languageId], references: [id])
  timezone            String             @default("Asia/Jerusalem")
  mode                GroupMode          @default(ONLINE)
  schedule            String?
  capacityMin         Int                @default(4)
  capacityMax         Int                @default(6)
  status              GroupStatus        @default(DRAFT)
  theme               String?
  seriesLength        Int?
  guideId             String?
  guide               SessionGuide?      @relation(fields: [guideId], references: [id])
