enum InterviewStage {
  RECRUITER_SCREEN
  TECHNICAL_SCREEN
  CODING
  SYSTEM_DESIGN
  BEHAVIORAL
  HIRING_MANAGER
  TAKE_HOME
  FINAL_ROUND
  OTHER
}

enum InterviewFormat {
  ONLINE
  ONSITE
  PAIR_PROGRAMMING
  WRITTEN_EXERCISE
  CONVERSATION
  OTHER
}

enum InterviewOutcome {
  OFFER
  REJECTED
  NO_RESPONSE
  WITHDREW
  IN_PROGRESS
}

enum ExperienceStatus {
  DRAFT
  PENDING_REVIEW
  NEEDS_CHANGES
  APPROVED
  SCHEDULED_FOR_PUBLICATION
  PUBLISHED
  REJECTED
  REMOVED
  WITHDRAWN_BY_AUTHOR
}

/// authorId is INTERNAL ONLY: restricted to moderation/reward services. Public
/// and library DTOs must never select or serialize this field.
model InterviewExperience {
  id       String @id @default(cuid())
  authorId String
  author   User   @relation("ExperienceAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  companyId       String
  company         Company        @relation(fields: [companyId], references: [id])
  targetRoleId    String?
  targetRole      TargetRole?    @relation(fields: [targetRoleId], references: [id])
  seniorityBandId String?
  seniorityBand   SeniorityBand? @relation(fields: [seniorityBandId], references: [id])
  regionId        String?
  region          Region?        @relation(fields: [regionId], references: [id])

  periodYear    Int
  periodQuarter Int // 1-4, never an exact date

  processDescription String  @db.VarChar(4000)
  whatIWishIKnew     String? @db.VarChar(2000)

  difficultyRating Int? // 1-5
  usefulnessRating Int? // 1-5
  outcome          InterviewOutcome?
  outcomeVisible   Boolean           @default(false)

  status      ExperienceStatus @default(DRAFT)
  publishAt   DateTime? // moderation-configured publication delay
  publishedAt DateTime?
  version     Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  stages              InterviewExperienceStage[]
  questions           InterviewQuestion[]
  topics              InterviewExperienceTopic[]
  reviews             ContributionReview[]
  revisionRequests    ContributionRevisionRequest[]
  attestation         ContributionAttestation?
  validations         ContributionValidation[]
  contentReports      ContentReport[]
  takedownRequests    TakedownRequest[]
  creditLedgerEntries CreditLedgerEntry[]
  professionalField   ProfessionalField?            @relation(fields: [professionalFieldId], references: [id])
