enum GuideStepKind {
  AGENDA
  PROMPT
  FOLLOWUP
}

/// Who a timed step belongs to — lets a guide express a presenter/listener
/// split (and a later role swap) as an ordered step list without needing to
/// know which real user is which; the UI assigns PRESENTER/LISTENER to
/// whichever participant is "up" at that point.
enum GuideStepRole {
  PRESENTER
  LISTENER
  BOTH
}

model SessionGuideStep {
  id              String        @id @default(cuid())
  guideId         String
  guide           SessionGuide  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  order           Int
  title           String
  prompt          String        @db.VarChar(2000)
  kind            GuideStepKind @default(AGENDA)
  role            GuideStepRole @default(BOTH)
  durationMinutes Int?

  @@index([guideId, order])
  @@map("session_guide_steps")
}

