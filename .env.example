# Copy this file to .env for local development.
# See README.md "Local development setup" for the one-command local database.

# --- Database -----------------------------------------------------------
# Local option A (recommended, zero install): run `npx prisma dev` and paste the
# TCP URL it prints (create a database first with `pnpm db:create`).
# Local option B: `docker compose up -d` and use the URL below as-is.
DATABASE_URL="postgresql://samepath:samepath@localhost:5432/samepath_dev?schema=public"

# --- App ------------------------------------------------------------------
# Public base URL used to build absolute links (verification emails, etc.)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sessions / auth --------------------------------------------------------
# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# --- Mail -------------------------------------------------------------------
# "console" (default) logs emails to the server console — no account needed.
# "smtp" sends real mail via the SMTP settings below (e.g. any provider that
# speaks SMTP). Swap in a different provider by implementing the Mailer
# interface in src/modules/notifications/mailer.ts.
MAIL_ADAPTER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SamePath <no-reply@samepath.local>"

# --- File storage -------------------------------------------------------------
# "local" (default) stores resume uploads on disk under .local-storage — for
# development only. "s3" stores them in an S3-compatible bucket using the
# credentials below (works with AWS S3, Cloudflare R2, MinIO, etc.).
STORAGE_ADAPTER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Payments -----------------------------------------------------------------
# "fake" (default) is a local, no-network payment provider for development and
# tests. Production integrations must be added behind the same interface in
# src/modules/payments/provider.ts and never enabled without explicit approval.
PAYMENT_PROVIDER="fake"

# --- Resume parsing -------------------------------------------------------------
# "deterministic" (default) uses the built-in heuristic/regex parser, no
# external calls. "ai" delegates to an external AI parser — requires
# RESUME_AI_API_KEY and must never be treated as authoritative before the
# user confirms the extracted draft.
RESUME_PARSER="deterministic"
RESUME_AI_API_KEY=""

# --- Rate limiting -------------------------------------------------------------
# In-memory by default (fine for a single-instance MVP). Swap for a shared
# store (e.g. Redis) before running multiple instances in production.
RATE_LIMIT_ADAPTER="memory"
