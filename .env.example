# Copy this file to .env for local development.
# See README.md "Local development setup" for the one-command local database.

# --- Database -----------------------------------------------------------
# Local option A (recommended, zero install): run `npx prisma dev`, create a
# database on it, and paste the TCP URL it prints. See README.md "Local
# development setup" for the full sequence (including the separate instance
# used for tests — `prisma dev` does not isolate same-instance databases).
# Local option B: `docker compose up -d` and use the URL below as-is.
DATABASE_URL="postgresql://samepath:samepath@localhost:5432/samepath_dev?schema=public"

# --- App ------------------------------------------------------------------
# Public base URL used to build absolute links (verification emails, etc.)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Sessions / auth --------------------------------------------------------
# Random 32+ byte secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-random-64-char-hex-string"

# --- Mail -------------------------------------------------------------------
# "console" (default) logs emails to the server console — no account needed.
# "smtp" sends real mail via the SMTP settings below (e.g. any provider that
# speaks SMTP). Swap in a different provider by implementing the Mailer
# interface in src/modules/notifications/mailer.ts.
MAIL_ADAPTER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="SamePath <no-reply@samepath.local>"

# --- File storage -------------------------------------------------------------
# "local" (default) stores resume uploads on disk under .local-storage — for
# development only. "s3" stores them in an S3-compatible bucket using the
# credentials below (works with AWS S3, Cloudflare R2, MinIO, etc.).
STORAGE_ADAPTER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Payments -----------------------------------------------------------------
# "fake" (default) is a local, no-network payment provider for development and
# tests. Production integrations must be added behind the same interface in
# src/modules/payments/provider.ts and never enabled without explicit approval.
PAYMENT_PROVIDER="fake"

# --- Resume parsing -------------------------------------------------------------
# "ai" (default) sends each uploaded résumé's extracted text to the Claude
# API (Anthropic) for structured extraction — requires RESUME_AI_API_KEY
# (an Anthropic API key). This is a real per-upload network call and cost,
# and it sends résumé content to a third-party service — see
# src/modules/resumes/ResumeUploadCard.tsx's disclosure copy and
# docs/resume-extraction-approach.md. "deterministic" uses the built-in
# heuristic/regex parser instead — free, no external calls, no résumé
# content ever leaves this process, but lower recall on unusual layouts.
# Either way, the result is always shown to the user as an editable draft
# before anything is saved to their profile.
RESUME_PARSER="ai"
RESUME_AI_API_KEY=""

# --- Rate limiting -------------------------------------------------------------
# In-memory by default (fine for a single-instance MVP). Swap for a shared
# store (e.g. Redis) before running multiple instances in production.
RATE_LIMIT_ADAPTER="memory"

# --- Google sign-in --------------------------------------------------------------
# "google" (default) talks to real Google OAuth — requires a Client ID/Secret
# from Google Cloud Console (APIs & Services -> Credentials -> Create
# Credentials -> OAuth client ID -> Web application), with
# http://localhost:3000/api/auth/google/callback added as an authorized
# redirect URI. "fake" skips Google entirely (no credentials needed) —
# useful for local dev/tests, see src/modules/auth/google-oauth.ts.
GOOGLE_OAUTH_ADAPTER="google"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Encrypts stored Google Meet OAuth refresh tokens at rest (AES-256-GCM, see
# src/modules/auth/crypto.ts#encryptSecret). Falls back to an insecure dev
# default if unset — set a real random 64-char hex string in production.
GOOGLE_TOKEN_ENCRYPTION_KEY=""

# --- Scheduled jobs -----------------------------------------------------------
# Shared secret an external scheduler (cron service, deploy-pipeline curl,
# etc.) must present to POST/GET /api/jobs/matching — see
# docs/scheduled-jobs.md for a local curl example and the production wiring
# pattern. Empty (the default) means the route refuses every request with
# 401, even a correctly-shaped one, so a fresh checkout can never
# accidentally expose it. Generate a real value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JOB_SCHEDULER_SECRET=""
# On Vercel, also set CRON_SECRET to this same value — Vercel Cron (vercel.json)
# authenticates with "Authorization: Bearer $CRON_SECRET".
